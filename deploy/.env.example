# ThreatSculpt v2 — deployment environment template.
#
#   cp deploy/.env.example deploy/.env   and fill in real values.
#
# deploy/.env is gitignored. NEVER commit a filled-in copy: every value below is
# either a secret or something that changes the security posture of the stack.
# There are no defaults for the secrets on purpose — the control plane refuses to
# start on a placeholder rather than run with a guessable credential.

# --- database ---------------------------------------------------------------
POSTGRES_USER=threatsculpt
POSTGRES_DB=threatsculpt
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- control plane ----------------------------------------------------------
# Minimum 32 characters; start-up fails below that.
# Generate: openssl rand -hex 32
TS_JWT_SECRET=

TS_ENVIRONMENT=production
TS_LOG_LEVEL=INFO
TS_LOG_JSON=true

# Comma-separated exact origins. A wildcard is rejected: the refresh token is a
# credentialed cookie, so `*` would let any site drive the API as a logged-in user.
# Leave empty when the browser reaches the API same-origin through the web proxy.
TS_CORS_ORIGINS=

# Number of proxy hops to trust in X-Forwarded-For. The compose stack puts nginx
# in front of the API, so 1. Set it to the real hop count if you add a load
# balancer or CDN — too high and a client can spoof its source IP past the
# per-IP rate limits; too low and every request appears to come from the proxy.
TS_TRUSTED_PROXY_COUNT=1

# Set to false ONLY for plain-HTTP local development. Over HTTP with this true,
# the browser silently discards the refresh cookie and sessions die after 15 min.
TS_COOKIE_SECURE=true
TS_COOKIE_DOMAIN=

# --- web --------------------------------------------------------------------
# Baked into the bundle at build time. Anything here is public.
VITE_API_BASE_URL=/api/v1
# Bind the dashboard to loopback unless a reverse proxy terminates TLS in front.
WEB_PUBLISH_ADDR=127.0.0.1
WEB_PORT=8080

TS_IMAGE_TAG=2.0.0

# --- scan agent (CUSTOMER SIDE — `--profile agent` only) --------------------
# In a real deployment these live on the customer's host, not in this file.
TS_AGENT_CONTROL_PLANE_URL=https://app.threatsculpt.example
TS_AGENT_NAME=compose-agent-01

# One-time enrollment token from POST /api/v1/agents (dashboard: Agents → New).
# Consumed on first start; ignored once the agent has a stored key.
TS_AGENT_ENROLLMENT_TOKEN=

# THE security boundary of the whole product. The agent refuses any scan target
# not inside these CIDRs, whatever the control plane asks for — so a compromised
# control plane cannot turn this agent into a scanner-for-hire. Comma-separated.
# Set it to the ranges this host is genuinely authorised to scan, and nothing more.
TS_AGENT_ALLOWLIST=10.0.0.0/8,192.168.0.0/16
