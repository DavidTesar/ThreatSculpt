# ThreatSculpt control plane — example environment.
# Copy to .env and fill in. NEVER commit a real .env; NEVER hardcode these in source.

# --- Database -------------------------------------------------------------
# Full DSN. Use a NON-superuser role: superusers and BYPASSRLS roles ignore
# Row-Level Security, which would disable the tenancy backstop entirely.
# Alembic also accepts plain DATABASE_URL, so a migration job needs only a DSN
# and none of the application secrets below.
TS_DATABASE_URL=postgresql://threatsculpt_app:CHANGE_ME@127.0.0.1:5432/threatsculpt_dev
TS_DB_POOL_SIZE=10
TS_DB_MAX_OVERFLOW=5
TS_DB_ECHO=false

# Role that migrations grant table privileges to (must match the DSN user).
TS_DB_APP_ROLE=threatsculpt_app

# Local development escape hatch ONLY. When 1, the app will boot against a
# SUPERUSER/BYPASSRLS role, which silently disables Row-Level Security and
# removes a layer of tenancy isolation. Never set this in a deployed
# environment; it is logged at CRITICAL on every boot.
# TS_ALLOW_SUPERUSER_DB=0

# --- Auth -----------------------------------------------------------------
# 32+ random bytes, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
TS_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
TS_JWT_ALGORITHM=HS256
TS_ACCESS_TOKEN_TTL_MINUTES=15
TS_REFRESH_TOKEN_TTL_DAYS=30
TS_REFRESH_COOKIE_NAME=ts_refresh
# Set false only for local http development.
TS_COOKIE_SECURE=true
TS_COOKIE_DOMAIN=

# --- HTTP -----------------------------------------------------------------
TS_ENVIRONMENT=development
TS_API_PREFIX=/api/v1
# Comma-separated. Never "*" — credentials are sent with cookies.
TS_CORS_ORIGINS=http://localhost:5173
TS_TRUSTED_PROXY_COUNT=0

# --- Rate limits ----------------------------------------------------------
TS_AUTH_RATE_LIMIT_PER_MINUTE=10
TS_GENERAL_RATE_LIMIT_PER_MINUTE=100
TS_MAX_FAILED_LOGINS=10
TS_LOGIN_LOCKOUT_MINUTES=15

# --- Logging --------------------------------------------------------------
TS_LOG_LEVEL=INFO
TS_LOG_JSON=true
